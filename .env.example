# Supabase cloud database (optional).
# Copy this file to ".env", fill in your project's values, then restart `npm run dev`.
# If these are left empty, the app works exactly as before (localStorage only).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
